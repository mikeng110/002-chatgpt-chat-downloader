{
  "name": "Hello Extensions",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "content_scripts": [
    {
        "matches": ["https://chatgpt.com/*"],
        "js": ["scripts/content.js"],
        "run_at": "document_idle"
    }
],
  "action": {
    "default_popup": "hello.html"
  }
}
